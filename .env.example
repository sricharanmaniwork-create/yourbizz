# ============================================================================
# YourBizz — Environment Variables
# ============================================================================
# Copy this file to .env.local (local dev) or set these in Vercel
# (Project Settings → Environment Variables → Production/Preview/Development).
# ============================================================================

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YourBizz
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourbizz.app

# ----------------------------------------------------------------------------
# Database (LOCAL SANDBOX — SQLite via Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ----------------------------------------------------------------------------
# Database (PRODUCTION — Supabase Postgres)
# ----------------------------------------------------------------------------
# Get these from Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # server-only, NEVER expose

# When switching to Supabase, also set DATABASE_URL to the Postgres connection
# string (Project Settings → Database → Connection string → URI):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?schema=public
# Then change prisma/schema.prisma `provider` from "sqlite" to "postgresql".

# ----------------------------------------------------------------------------
# NextAuth.js
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Auth providers (Google OAuth — optional but recommended)
# ----------------------------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
# Get from https://resend.com/api-keys
# Verify your sending domain at https://resend.com/domains first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourbizz.app
RESEND_REPLY_TO=support@yourbizz.app

# ----------------------------------------------------------------------------
# Spam protection (hCaptcha — for public forms)
# ----------------------------------------------------------------------------
# Get from https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ----------------------------------------------------------------------------
# Stripe (Phase 10 — billing)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Optional: Google Places (Address field autocomplete)
# ----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ----------------------------------------------------------------------------
# Optional: Sentry (error monitoring)
# ----------------------------------------------------------------------------
SENTRY_DSN=

# ----------------------------------------------------------------------------
# GitHub (LOCAL ONLY — for pushing to your repo. NEVER put on Vercel.)
# ----------------------------------------------------------------------------
# Create a personal access token at https://github.com/settings/tokens
# (scopes: repo, workflow). Only used by your local git CLI.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
